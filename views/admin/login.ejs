<section class="auth-wrapper">
  <form class="auth-card" method="post" action="/admin/login" autocomplete="off">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <p class="eyebrow">Administración</p>
    <h1>Acceso al panel</h1>
    <p class="muted">Ingresa con un usuario autorizado de la aplicación.</p>

    <% if (typeof loginError !== 'undefined' && loginError) { %>
      <div class="alert alert-danger" role="alert"><%= loginError %></div>
    <% } %>

    <label class="form-label" for="username">Usuario</label>
    <input class="form-control" id="username" name="username" type="text" maxlength="100" required autofocus>

    <label class="form-label" for="password">Contraseña</label>
    <input class="form-control" id="password" name="password" type="password" maxlength="200" required>

    <button class="button button-primary button-block" type="submit">Iniciar sesión</button>

    <div class="pwa-install-card" data-pwa-install-wrap hidden>
      <div class="pwa-install-copy">
        <strong>Instalar en este dispositivo</strong>
        <span>Abre Credenciales Digitales como una aplicación, sin la barra de Chrome.</span>
      </div>
      <button class="button button-secondary button-block pwa-install-button" type="button" data-pwa-install>
        Instalar Credenciales Digitales
      </button>
      <small class="help-text pwa-install-status" data-pwa-install-status>La instalación conserva los mismos permisos y la misma seguridad del sitio.</small>
    </div>
  </form>
</section>
