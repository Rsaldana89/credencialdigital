PORT=3000
APP_URL=http://localhost:3000

# Zona horaria usada para mostrar asistencias y premios guardados en UTC
EVENT_TIME_ZONE=America/Mexico_City

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sistema_gestion

# Solo para el primer arranque si chc_admin_users está vacía.
# La app importa estas cuentas a MySQL con contraseña hasheada y después
# los usuarios nuevos se administran desde Admin > Usuarios.
ADMIN_USER=admin
ADMIN_PASSWORD=cambiar_contrasena_segura

# Usuarios iniciales opcionales de Capital Humano (bootstrap)
CAPITAL_HUMANO_1_USER=capitalhumano1
CAPITAL_HUMANO_1_PASSWORD=cambiar_contrasena_en_railway
CAPITAL_HUMANO_2_USER=capitalhumano2
CAPITAL_HUMANO_2_PASSWORD=cambiar_contrasena_en_railway

SESSION_SECRET=cambiar_esto_por_una_clave_segura

# Importación masiva de fotografías (opcionales)
BULK_ZIP_MAX_MB=200
BULK_MAX_IMAGES=500
BULK_MAX_ARCHIVE_ENTRIES=700
BULK_IMAGE_MAX_MB=10
BULK_TOTAL_UNCOMPRESSED_MB=500
BULK_REPORT_TTL_MINUTES=60
