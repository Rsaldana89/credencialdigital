<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#4b0f19">
  <meta name="application-name" content="Credenciales Digitales QR CHC">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content="Credenciales CHC">
  <link rel="manifest" href="/manifest.webmanifest?v=1.0.54">
  <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png?v=1.0.54">
  <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png?v=1.0.54">
  <title><%= title %> | CHC</title>
  <link rel="stylesheet" href="/css/styles.css?v=1.0.54">
  <script src="/js/pwa.js?v=1.0.54" defer></script>
  <% if (typeof pageStyles !== 'undefined' && pageStyles) { %>
    <link rel="stylesheet" href="<%= pageStyles %>">
  <% } %>
  <link rel="stylesheet" href="/css/v1054-enhancements.css?v=1.0.54">
</head>
<body class="<%= (typeof hideSiteChrome !== 'undefined' && hideSiteChrome) ? 'credential-standalone-body' : '' %>">
  <% if (!(typeof hideSiteChrome !== 'undefined' && hideSiteChrome)) { %>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="/" aria-label="Inicio Credenciales Digitales QR CHC">
        <span class="brand-logo-panel"><img src="/img/logo-chc.png" alt="Cremería Hermanos Coronel" class="brand-logo"></span>
        <span>Credenciales Digitales QR</span>
      </a>
      <nav class="main-nav" aria-label="Navegación principal">
        <% if (isAuthenticated) { %>
          <a class="nav-link <%= currentPath === '/admin' ? 'active' : '' %>" href="/admin">Panel</a>
          <a class="nav-link <%= currentPath.startsWith('/admin/empleados') ? 'active' : '' %>" href="/admin/empleados">Empleados</a>
          <a class="nav-link <%= currentPath.startsWith('/admin/eventos') ? 'active' : '' %>" href="/admin/eventos">Eventos</a>
          <a class="nav-link <%= currentPath.startsWith('/admin/fotografias') ? 'active' : '' %>" href="/admin/fotografias/importar">Fotografías</a>
          <% if (adminRole === 'admin') { %>
            <a class="nav-link <%= currentPath.startsWith('/admin/usuarios') ? 'active' : '' %>" href="/admin/usuarios">Usuarios</a>
          <% } %>
        <% } else { %>
          <a class="nav-link" href="/admin/login">Administración</a>
        <% } %>
      </nav>
      <% if (isAuthenticated) { %>
        <div class="session-actions" aria-label="Sesión administrativa">
          <span class="session-user" title="Usuario conectado">
            <span class="session-user-indicator" aria-hidden="true"></span>
            <span class="session-user-copy">
              <span class="session-user-name"><%= adminDisplayName || adminUser %></span>
              <small><%= adminRole === 'admin' ? 'Administrador' : (adminRole === 'event_operator' ? 'Operador de Eventos' : 'Capital Humano') %></small>
            </span>
          </span>
          <form method="post" action="/admin/logout" class="logout-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="logout-button" type="submit" title="Cerrar la sesión administrativa">
              <span>Cerrar sesión</span>
            </button>
          </form>
        </div>
      <% } %>
    </div>
  </header>
  <% } %>

  <main class="page-main <%= (typeof hideSiteChrome !== 'undefined' && hideSiteChrome) ? 'page-main--credential-standalone' : '' %>">
    <div class="container <%= (typeof hideSiteChrome !== 'undefined' && hideSiteChrome) ? 'container--credential-standalone' : '' %>">
      <% if (flash) { %>
        <div class="alert alert-<%= flash.type %>" role="alert"><%= flash.message %></div>
      <% } %>
      <%- body %>
    </div>
  </main>

  <% if (!(typeof hideSiteChrome !== 'undefined' && hideSiteChrome)) { %>
  <footer class="site-footer">
    <div class="container footer-inner">
      <span>Cremería Hermanos Coronel</span>
      <span>Credenciales Digitales QR CHC</span>
    </div>
  </footer>
  <% } %>
  <script src="/js/v1054-enhancements.js?v=1.0.54" defer></script>
</body>
</html>
