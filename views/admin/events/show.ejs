<section
  class="event-live-root"
  id="event-live-root"
  data-event-id="<%= event.id %>"
  data-event-type="<%= event.event_type %>"
  data-event-status="<%= event.status %>"
  data-invite-mode="<%= event.invite_mode %>"
  data-event-reference-date="<%= String(event.event_date || '').slice(0, 10) %>"
  data-all-tenure-groups="<%= tenureGroups.map((group) => group.code).join(',') %>"
  data-last-log-id="<%= latestLogId || 0 %>"
  data-csrf="<%= csrfToken %>"
>
  <section class="event-scanner-sticky">
    <div class="event-scanner-head">
      <div>
        <span class="event-id">Evento #<%= event.id %></span>
        <h1><%= event.event_name %></h1>
        <p><%= event.event_type === 'FIESTA_PREMIOS' ? 'Fiesta con Premios' : 'General' %> · <%= formatDateTime(event.event_date) %></p>
      </div>
      <div class="event-scanner-head-actions">
        <span id="event-status-badge" class="event-status <%= event.status === 'OPEN' ? 'event-status--open' : 'event-status--closed' %>">
          <%= event.status === 'OPEN' ? 'Abierto' : 'Cerrado' %>
        </span>
        <button
          class="event-scanner-toggle"
          type="button"
          id="event-scanner-toggle"
          aria-expanded="true"
          aria-controls="event-scanner-collapsible"
        >
          <span id="event-scanner-toggle-label">Ocultar escáner</span>
          <span class="event-scanner-toggle__icon" aria-hidden="true">⌃</span>
        </button>
      </div>
    </div>

    <div class="event-tenure-toolbar">
      <details class="event-tenure-filter" id="event-tenure-filter">
        <summary>
          <span>Antigüedad</span>
          <strong id="event-tenure-filter-label">Todos los rangos</strong>
        </summary>
        <div class="event-tenure-filter-panel">
          <div class="event-tenure-filter-heading">
            <div>
              <strong>Filtrar la lista y el escáner</strong>
              <span>Calculada a la fecha del evento: <%= formatDate(event.event_date) %>.</span>
            </div>
          </div>
          <div class="event-tenure-options">
            <% tenureGroups.forEach((group) => { %>
              <label class="event-tenure-option event-tenure-option--<%= group.cssClass %>">
                <input
                  type="checkbox"
                  value="<%= group.code %>"
                  data-tenure-filter-code="<%= group.code %>"
                  checked
                >
                <span class="event-tenure-option__copy">
                  <strong><%= group.label %></strong>
                  <small><%= group.count %> invitado<%= group.count === 1 ? '' : 's' %></small>
                </span>
              </label>
            <% }) %>
          </div>
          <div class="event-tenure-filter-actions">
            <button class="button button-secondary button-small" type="button" id="event-tenure-select-all">Seleccionar todos</button>
            <button class="button button-secondary button-small" type="button" id="event-tenure-clear">Limpiar</button>
          </div>
        </div>
      </details>

      <div class="event-tenure-active-summary" aria-live="polite">
        <strong id="event-tenure-active-title">Todos los rangos</strong>
        <span id="event-tenure-active-counts">Mostrando <%= attendees.length %> invitados · <%= attendees.filter((item) => item.attended_at).length %> con asistencia</span>
      </div>

      <div class="event-filter-export-actions">
        <a class="button button-secondary button-small" id="event-export-filtered-xlsx" href="/admin/eventos/<%= event.id %>/exportar.xlsx?scope=filtered&amp;antiguedad=<%= tenureGroups.map((group) => group.code).join(',') %>">Excel del filtro</a>
        <a class="button button-secondary button-small" id="event-export-filtered-pdf" href="/admin/eventos/<%= event.id %>/exportar.pdf?scope=filtered&amp;antiguedad=<%= tenureGroups.map((group) => group.code).join(',') %>">PDF del filtro</a>
      </div>
    </div>

    <div class="event-scanner-shortcuts" id="event-scanner-shortcuts">
      <span>Escáner oculto para dejar espacio a la consulta.</span>
      <div>
        <button class="button button-secondary button-small" type="button" id="event-jump-search">Buscar empleado</button>
        <button class="button button-secondary button-small" type="button" id="event-jump-list">Ver lista</button>
      </div>
    </div>

    <div class="event-scanner-collapsible" id="event-scanner-collapsible">
      <div class="event-scanner-grid">
        <div class="event-camera-box">
          <video id="event-scanner-video" class="event-scanner-video" playsinline muted></video>
          <div class="event-camera-overlay" aria-hidden="true"><span></span></div>
          <div class="event-camera-placeholder" id="event-camera-placeholder">
            <strong>Escáner QR</strong>
            <span>Activa la cámara para leer la credencial existente.</span>
          </div>
        </div>
        <div class="event-scanner-controls">
          <div id="event-scanner-message" class="event-scanner-message" role="status">
            <% if (event.status === 'OPEN') { %>
              Activa la cámara. El QR se comparará con Credenciales Digitales, esta lista y el filtro de antigüedad activo.
            <% } else { %>
              El evento está cerrado. El escáner y los cambios están deshabilitados.
            <% } %>
          </div>
          <div class="button-row event-camera-buttons">
            <button class="button button-primary" type="button" id="event-start-camera" <%= event.status !== 'OPEN' ? 'disabled' : '' %>>Activar cámara</button>
            <button class="button button-secondary" type="button" id="event-switch-camera" hidden>Cambiar cámara</button>
            <button class="button button-secondary" type="button" id="event-stop-camera" disabled>Detener</button>
          </div>
          <p class="help-text">La cámara requiere HTTPS. Cada escaneo consulta MySQL en ese momento y solo registra empleados incluidos en los rangos marcados.</p>
        </div>
      </div>

      <div class="event-scan-result" id="event-scan-result" hidden>
        <div class="event-scan-result__main">
          <span class="event-result-kicker" id="event-result-kicker">Resultado</span>
          <strong id="event-result-name"></strong>
          <span id="event-result-meta"></span>
          <span id="event-result-status"></span>
        </div>
        <div class="event-result-actions" id="event-result-actions">
          <% if (event.event_type === 'FIESTA_PREMIOS') { %>
            <button class="button button-primary" type="button" id="event-result-prize" hidden>Marcar Premio</button>
            <button class="button button-secondary" type="button" id="event-result-consolation" hidden>Marcar Consolación</button>
          <% } %>
        </div>
      </div>
    </div>
  </section>

  <div class="event-page-content">
    <div class="event-page-topbar">
      <a class="back-link" href="/admin/eventos">← Volver a eventos</a>
      <div class="page-actions">
        <a class="button button-secondary" href="/admin/eventos/<%= event.id %>/exportar.xlsx">Excel completo</a>
        <a class="button button-secondary" href="/admin/eventos/<%= event.id %>/exportar.pdf">PDF completo</a>
        <form method="post" action="/admin/eventos/<%= event.id %>/estado">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="status" value="<%= event.status === 'OPEN' ? 'CLOSED' : 'OPEN' %>">
          <button class="button <%= event.status === 'OPEN' ? 'button-danger' : 'button-primary' %>" type="submit">
            <%= event.status === 'OPEN' ? 'Cerrar evento' : 'Reabrir evento' %>
          </button>
        </form>
      </div>
    </div>

    <details class="panel-card event-invite-management">
      <summary class="event-invite-management__summary">
        <span>
          <strong>Gestionar invitados</strong>
          <small>Agregar nuevos ingresos sin volver a crear el evento</small>
        </span>
        <span class="event-invite-management__chevron" aria-hidden="true">⌄</span>
      </summary>
      <div class="event-invite-management__body">
        <% if (event.status !== 'OPEN') { %>
          <p class="muted">El evento está cerrado. Reábrelo para agregar nuevos invitados.</p>
        <% } else if (event.invite_mode === 'ALL_ACTIVE') { %>
          <div class="event-invite-management__copy">
            <strong>Actualizar con los empleados activos actuales</strong>
            <p>Agrega únicamente a quienes hoy están activos y todavía no aparecen en esta lista. No elimina invitados ni modifica asistencias o premios ya registrados.</p>
          </div>
          <form method="post" action="/admin/eventos/<%= event.id %>/invitados/actualizar" class="event-invite-management__form" onsubmit="return confirm('Se agregarán únicamente los empleados activos que todavía no estén invitados. ¿Continuar?');">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="button button-primary" type="submit">Agregar nuevos ingresos</button>
          </form>
        <% } else { %>
          <div class="event-invite-management__copy">
            <strong>Este evento usa una selección manual</strong>
            <p>Para respetar la lista original, captura solo los números de los nuevos empleados que quieras agregar. Deben estar activos.</p>
          </div>
          <form method="post" action="/admin/eventos/<%= event.id %>/invitados/agregar" class="event-invite-management__manual-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <label class="event-field event-field--wide">
              <span>Números de empleado</span>
              <textarea class="form-control event-textarea" name="employee_numbers" rows="2" required placeholder="12331, 12350 o uno por línea"></textarea>
            </label>
            <button class="button button-primary" type="submit">Agregar a la lista</button>
          </form>
        <% } %>
        <p class="event-invite-management__note">Los nuevos invitados conservan una fotografía de nombre, puesto, departamento y fecha de ingreso al momento de agregarlos. Si falta su QR, también se revisa su generación automática.</p>
      </div>
    </details>

    <section class="event-live-stats">
      <article><strong id="event-stat-invited"><%= event.invited_count || 0 %></strong><span>Total invitados</span></article>
      <article><strong id="event-stat-attended"><%= event.attended_count || 0 %></strong><span>Total asistentes</span></article>
      <% if (event.event_type === 'FIESTA_PREMIOS') { %>
        <article><strong id="event-stat-prizes"><%= event.prize_count || 0 %></strong><span>Premios</span></article>
        <article><strong id="event-stat-consolations"><%= event.consolation_count || 0 %></strong><span>Consolación</span></article>
      <% } %>
    </section>

    <section class="panel-card event-manual-search-section" id="event-manual-search-section">
      <div class="event-section-title-row">
        <div>
          <h2>Búsqueda manual</h2>
          <p class="muted">Busca por número de empleado, nombre, puesto o departamento. La búsqueda respeta el filtro de antigüedad activo.</p>
        </div>
      </div>
      <div class="event-manual-search-row">
        <input class="form-control" type="search" id="event-manual-search" placeholder="Número, nombre, puesto o departamento" autocomplete="off">
        <button class="button button-primary" type="button" id="event-manual-search-button">Buscar</button>
      </div>
      <div id="event-manual-results" class="event-manual-results" aria-live="polite"></div>
    </section>

    <section class="panel-card event-attendance-section" id="event-attendance-section">
      <div class="event-section-title-row">
        <div>
          <h2>Lista del evento</h2>
          <p class="muted"><%= event.event_type === 'FIESTA_PREMIOS' ? 'La asistencia y los premios pertenecen únicamente a este evento.' : 'La asistencia pertenece únicamente a este evento.' %> La antigüedad se calcula al <%= formatDate(event.event_date) %>.</p>
        </div>
      </div>

      <div class="table-responsive event-table-wrap">
        <table class="event-table">
          <thead>
            <tr>
              <th>Empleado</th>
              <th>Nombre / puesto</th>
              <th>Antigüedad</th>
              <th>Asistencia</th>
              <% if (event.event_type === 'FIESTA_PREMIOS') { %><th>Premios</th><% } %>
            </tr>
          </thead>
          <tbody>
            <% attendees.forEach((attendee) => { %>
              <% const tenure = getTenureDetails(attendee.start_date_snapshot, String(event.event_date).slice(0, 10)); %>
              <tr
                data-attendee-id="<%= attendee.id %>"
                data-tenure-group="<%= tenure.groupCode %>"
                data-attended="<%= attendee.attended_at ? '1' : '0' %>"
                data-award-type="<%= attendee.award_type || '' %>"
              >
                <td data-label="Empleado"><strong><%= formatEmployeeNumber(attendee.employee_number) %></strong></td>
                <td data-label="Nombre / puesto">
                  <strong><%= attendee.full_name_snapshot %></strong>
                  <span class="table-secondary"><%= attendee.puesto_snapshot || 'Sin puesto' %> · <%= attendee.department_snapshot || 'Sin departamento' %></span>
                </td>
                <td data-label="Antigüedad" data-role="tenure">
                  <span class="event-tenure-badge event-tenure-badge--<%= tenure.groupCssClass %>"><%= tenure.groupBadgeLabel %></span>
                  <strong class="event-tenure-value"><%= tenure.label %></strong>
                  <span class="table-secondary">Ingreso: <%= formatDate(attendee.start_date_snapshot) %></span>
                </td>
                <td data-label="Asistencia" data-role="attendance">
                  <% if (attendee.attended_at) { %>
                    <span class="pill pill-success">Asistió</span>
                    <span class="table-secondary"><%= formatRecordedDateTime(attendee.attended_at) %> · <%= attendee.attendance_method || '' %></span>
                  <% } else if (event.status === 'OPEN') { %>
                    <form class="event-row-action-form" data-action="checkin" method="post" action="/admin/eventos/<%= event.id %>/asistentes/<%= attendee.id %>/asistencia">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="button button-primary button-small" type="submit">Marcar asistencia</button>
                    </form>
                  <% } else { %>
                    <span class="pill pill-muted">No asistió</span>
                  <% } %>
                </td>
                <% if (event.event_type === 'FIESTA_PREMIOS') { %>
                  <td data-label="Premios" data-role="award">
                    <% if (attendee.award_type) { %>
                      <span class="pill pill-success"><%= attendee.award_type === 'PREMIO' ? 'Premio entregado' : 'Consolación entregada' %></span>
                      <span class="table-secondary"><%= formatRecordedDateTime(attendee.award_delivered_at) %></span>
                    <% } else if (!attendee.attended_at) { %>
                      <span class="pill pill-muted">Requiere asistencia</span>
                    <% } else if (event.status !== 'OPEN') { %>
                      <span class="pill pill-muted">Sin entrega</span>
                    <% } else { %>
                      <div class="event-award-buttons">
                        <form class="event-row-action-form" data-action="award" method="post" action="/admin/eventos/<%= event.id %>/asistentes/<%= attendee.id %>/premio">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <input type="hidden" name="award_type" value="PREMIO">
                          <input type="hidden" name="source" value="LIST">
                          <button class="button button-primary button-small" type="submit">Premio</button>
                        </form>
                        <form class="event-row-action-form" data-action="award" method="post" action="/admin/eventos/<%= event.id %>/asistentes/<%= attendee.id %>/premio">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <input type="hidden" name="award_type" value="CONSOLACION">
                          <input type="hidden" name="source" value="LIST">
                          <button class="button button-secondary button-small" type="submit">Consolación</button>
                        </form>
                      </div>
                    <% } %>
                  </td>
                <% } %>
              </tr>
            <% }) %>
            <tr id="event-filter-empty-row" class="event-filter-empty-row" hidden>
              <td colspan="<%= event.event_type === 'FIESTA_PREMIOS' ? 5 : 4 %>">
                No hay invitados dentro de los rangos de antigüedad seleccionados.
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>
  </div>
</section>

<script src="/vendor/jsqr/jsQR.js?v=1.0.49" defer></script>
<script src="/js/events-show.js?v=1.0.49" defer></script>
