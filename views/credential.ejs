<section class="chc30-page" aria-label="Identificación digital de empleado">
  <article class="chc30-card" id="digitalCredential">
    <div class="chc30-header-shape" aria-hidden="true"></div>
    <div class="chc30-gold-diagonal" aria-hidden="true"></div>
    <div class="chc30-slot" aria-hidden="true"></div>
    <img src="/img/logo-corporativo-v30.png" alt="Hermanos Coronel Cremería" class="chc30-logo-art">

    <div class="chc30-photo-frame">
      <div class="chc30-photo-gold">
        <div class="chc30-photo-white">
          <img src="/e/<%= token %>/foto" alt="Foto de <%= employee.full_name || 'empleado' %>" class="chc30-photo">
        </div>
      </div>
    </div>

    <div class="chc30-fields">
      <div class="chc30-field-row">
        <span class="chc30-icon" aria-hidden="true">
          <svg viewBox="0 0 64 64"><circle cx="32" cy="21" r="9"/><path d="M15 51c0-11 7-18 17-18s17 7 17 18z"/></svg>
        </span>
        <div class="chc30-field-copy">
          <span class="chc30-label">Nombre de la persona trabajadora:</span>
          <strong class="chc30-value"><%= employee.full_name || 'No disponible' %></strong>
        </div>
      </div>

      <div class="chc30-field-row">
        <span class="chc30-icon" aria-hidden="true">
          <svg viewBox="0 0 64 64">
            <rect x="9" y="16" width="46" height="37" rx="4" fill="none" stroke="currentColor" stroke-width="4"/>
            <rect x="25" y="8" width="14" height="12" rx="3"/>
            <circle cx="22" cy="32" r="6"/>
            <path d="M13 46c1-7 4-10 9-10s8 3 9 10z"/>
            <path d="M38 29h11M38 36h11M38 43h8" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
          </svg>
        </span>
        <div class="chc30-field-copy">
          <span class="chc30-label"># de Empleado:</span>
          <strong class="chc30-value"><%= displayEmployeeNumber %></strong>
        </div>
      </div>

      <div class="chc30-field-row">
        <span class="chc30-icon" aria-hidden="true">
          <svg viewBox="0 0 64 64">
            <rect x="8" y="22" width="48" height="31" rx="5" fill="none" stroke="currentColor" stroke-width="4"/>
            <path d="M23 22v-5c0-3 2-5 5-5h8c3 0 5 2 5 5v5M8 34h48" fill="none" stroke="currentColor" stroke-width="4"/>
            <rect x="29" y="31" width="7" height="7" rx="1"/>
          </svg>
        </span>
        <div class="chc30-field-copy">
          <span class="chc30-label">Puesto de Trabajo:</span>
          <strong class="chc30-value"><%= employee.puesto || 'No disponible' %></strong>
        </div>
      </div>

      <div class="chc30-field-row">
        <span class="chc30-icon" aria-hidden="true">
          <svg viewBox="0 0 64 64">
            <rect x="10" y="14" width="44" height="41" rx="5" fill="none" stroke="currentColor" stroke-width="4"/>
            <path d="M20 8v12M44 8v12M10 27h44" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
            <path d="M19 34h6v6h-6zM29 34h6v6h-6zM39 34h6v6h-6zM19 44h6v6h-6zM29 44h6v6h-6zM39 44h6v6h-6z"/>
          </svg>
        </span>
        <div class="chc30-field-copy">
          <span class="chc30-label">Fecha de Ingreso:</span>
          <strong class="chc30-value"><%= formattedStartDate %></strong>
        </div>
      </div>

      <div class="chc30-field-row">
        <span class="chc30-icon chc30-icon--shield" aria-hidden="true">
          <svg viewBox="0 0 64 64">
            <path d="M32 6 52 14v15c0 13-8 23-20 29C20 52 12 42 12 29V14z"/>
            <path class="chc30-icon-cut" d="M28 20h8v8h8v8h-8v8h-8v-8h-8v-8h8z"/>
          </svg>
        </span>
        <div class="chc30-field-copy">
          <span class="chc30-label">NSS:</span>
          <strong class="chc30-value"><%= employee.nss || 'No disponible' %></strong>
        </div>
      </div>
    </div>

    <div class="chc30-qr-separator" aria-hidden="true"></div>
    <div class="chc30-qr-panel" aria-label="Código QR asociado">
      <div class="chc30-qr-body">
        <img src="<%= qrDataUrl %>" alt="Código QR asociado a la credencial" class="chc30-qr">
      </div>
      <div class="chc30-qr-caption">QR ASOCIADO</div>
    </div>

    <footer class="chc30-footer">
      <img src="/img/frase-corporativa-v30.png" alt="Toda una tradición familiar" class="chc30-slogan-art">
    </footer>
  </article>

  <div class="chc30-meta" aria-label="Estado de la credencial">
    <div class="chc30-meta-item chc30-meta-item--active">Activo: Sí</div>
    <div class="chc30-meta-item">Fecha de consulta: <%= generatedAt %></div>
  </div>

  <div class="chc30-actions" aria-label="Opciones de la credencial">
    <a class="button button-primary" href="/e/<%= token %>/credencial.png" download>Descargar credencial PNG</a>
    <button class="button button-secondary" type="button" data-print-credential>Imprimir o guardar PDF</button>
  </div>
</section>

<script src="/js/credential.js" defer></script>
